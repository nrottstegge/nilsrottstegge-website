#!/bin/sh
set -eu
# Compare the actual commit being pushed, including when a local branch pushes to main.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  if [ "$remote_ref" = refs/heads/main ]; then
    node scripts/sync-cv.mjs --check-ref "$local_sha"
  fi
done
