---
import { withBase } from '../lib/paths';
---

<header class="header">
  <div class="bar">
    <a class="brand" href={withBase('/')}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <rect x="0.5" y="0.5" width="15" height="15" fill="none" stroke="currentColor" />
        <path d="M8 0.5V15.5M0.5 8H15.5M12 0.5V8M8 4H15.5" stroke="currentColor" fill="none" />
      </svg>
      <span class="name">Nils Rottstegge</span>
    </a>
    <nav aria-label="Main">
      <ul>
        <li><a href={withBase('/#projects')}>Projects</a></li>
        <li><a href={withBase('/cv/')} data-astro-prefetch>CV</a></li>
        <li><a href={withBase('/#contact')}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: rgb(250 250 248 / 0.94);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    text-decoration: none;
    min-height: 44px;
  }
  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--fg-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--fg);
  }
  @media (max-width: 520px) {
    .brand .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
