---
import { about, contact } from '../../data/profile';
---

<section class="contact wrap" id="contact" aria-labelledby="contact-title">
  <div class="about">
    <p class="mono label">About</p>
    <p class="text">{about}</p>
  </div>
  <div>
    <h2 id="contact-title">Contact</h2>
    <p class="muted">Questions, opportunities or a good sparse matrix? Write me.</p>
    <ul>
      <li><a class="big" href={`mailto:${contact.email}`}>{contact.email}</a></li>
      <li><a href={contact.linkedin} rel="me">linkedin.com/in/nilsrottstegge ↗</a></li>
      <li><a href={contact.github} rel="me">github.com/nrottstegge ↗</a></li>
    </ul>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 3rem clamp(2rem, 6vw, 6rem);
    padding-block: clamp(5rem, 14vh, 9rem);
  }
  .label {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .text {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.5;
    color: var(--fg-2);
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    margin-bottom: 0.75rem;
  }
  ul {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .big {
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    font-weight: 500;
  }
</style>
