---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
---

<Base title="404">
  <article class="wrap page">
    <p class="mono">404 · leaf not found</p>
    <h1>This cell is empty.</h1>
    <p><a href={withBase('/')}>Back to the root</a></p>
  </article>
</Base>

<style>
  .page {
    min-height: 70vh;
    padding-block: calc(var(--header-h) + 6rem) 4rem;
    display: grid;
    align-content: center;
    gap: 1rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
  }
  .mono {
    color: var(--muted);
  }
</style>
