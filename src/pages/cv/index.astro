---
import Base from '../../layouts/Base.astro';
import CvLinks from '../../components/CvLinks.astro';
import { about } from '../../data/profile';
---

<Base title="CV">
  <article class="wrap page">
    <p class="mono kicker">PDF · 1 page</p>
    <h1>Curriculum Vitae</h1>
    <p class="lead">One page. Open it in your browser or download the PDF.</p>
    <CvLinks />
    <p class="about muted">{about}</p>
  </article>
</Base>

<style>
  .page {
    padding-block: calc(var(--header-h) + 5rem) 6rem;
    max-width: 48rem;
  }
  .page :global(.cv-links) {
    justify-content: flex-start;
  }
  .kicker {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 900;
    margin-bottom: 1rem;
  }
  .lead {
    color: var(--fg-2);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  .about {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
